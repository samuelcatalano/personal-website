+def grain(p):
+    # smooth pseudo-noise in [-1, 1], about 12 cm features: per-vertex random noise shows as facets on these shells
+    return math.sin(p.x * 52 + p.z * 41) * math.sin(p.y * 47 - p.z * 59)
+
+
+def mean_edge(verts, faces):
+    es = {(min(a, b), max(a, b)) for f in faces for a, b in zip(f, f[1:] + f[:1])}
+    return sum((verts[a] - verts[b]).length for a, b in es) / max(1, len(es))
+
+
+def rescale(cols, g):
+    # per-vertex factors g, normalised so each channel's mean colour is unchanged (the runtime tint divides by that mean)
+    k = [sum(c[ch] for c in cols) / max(sum(c[ch] * f for c, f in zip(cols, g)), 1e-9) for ch in range(3)]
+    out = [tuple(min(1.0, c[ch] * f * k[ch]) for ch in range(3)) + (1.0,) for c, f in zip(cols, g)]
+    m0 = [sum(c[ch] for c in cols) for ch in range(3)]
+    m1 = [sum(c[ch] for c in out) for ch in range(3)]
+    assert all(abs(a - b) <= 1e-3 * max(a, 1e-6) for a, b in zip(m0, m1)), "fabric changed a part's mean colour"
+    return out
+
+
+def leg_seam(H, p):
+    # 0..1 in a narrow band along the outer or inner side seam of the nearest leg segment (thigh or calf)
+    cands = []
+    for s, dx in (("l", 1), ("r", -1)):
+        for name in (f"thigh_{s}", f"calf_{s}"):
+            h, t = H.B[name]
+            L = (t - h).length
+            ax = (t - h).normalized()
+            perp = p - (h + ax * (clamp((p - h).dot(ax) / L) * L))
+            cands.append((perp.length, perp, ax, dx))
+    d, perp, ax, dx = min(cands, key=lambda c: c[0])
+    if d > 0.2 or d < 1e-6:
+        return 0.0
+    th = math.acos(clamp(perp.normalized().dot(lateral(ax, dx)), -1.0, 1.0))
+    return max(math.exp(-(th / 0.25) ** 2), math.exp(-((math.pi - th) / 0.25) ** 2))
+
+
+def fabric_top(H, verts, faces, cols, kind, C):
+    # zero-mean grain on a top: armpit, elbow and hip folds, sun-faded shoulders, and the kind's own texture
+    zlo = C["zlo"]
+    elbows = [H.B[f"lowerarm_{s}"][0] for s in ("l", "r")]
+    rib = max(0.012, 3.0 * mean_edge(verts, faces))  # ponytail: ribs span 3 vertex spacings, finer would alias into noise
+    g = []
+    for p in verts:
+        w = H.sw(p)
+        ua = w.get("upperarm_l", 0.0) + w.get("upperarm_r", 0.0)
+        wl = w.get("lowerarm_l", 0.0) + w.get("lowerarm_r", 0.0)
+        f = -0.05 * math.exp(-((ua - 0.5) / 0.3) ** 2) * math.exp(-((p.z - 1.30) / 0.08) ** 2)  # armpit
+        f -= 0.05 * math.exp(-(min((p - e).length for e in elbows) / 0.06) ** 2)  # elbow crease
+        f -= 0.04 * math.exp(-((p.z - zlo - 0.12) / 0.06) ** 2) * smooth(0.05, 0.12, abs(p.x))  # hip
+        f += 0.04 * smooth(1.38, 1.50, p.z) * smooth(0.05, 0.12, abs(p.x))  # sun-faded shoulders
+        if kind == "sweater_print":
+            f += 0.03 * math.sin(2 * math.pi * p.x / rib)  # vertical knit ribs
+        elif kind == "hoodie":
+            f += 0.01 * grain(p)  # fleece grain
+        elif kind == "puffer":
+            mottle = 0.5 + 0.25 * math.sin(p.x * 23 + p.z * 17) + 0.25 * math.sin(p.y * 19 - p.z * 29)
+            f -= 0.05 * mottle * (math.exp(-((p.z - zlo) / 0.05) ** 2) + smooth(0.5, 0.9, wl))  # dirt at hem and sleeves
+        g.append(1.0 + f)
+    return rescale(cols, g)
+
+
+def fabric_bottom(H, verts, cols, kind, C):
+    # zero-mean grain on trousers: a hip fold, and the kind's own fading, seams or grain
+    zhi = C["zhi"]
+    g = []
+    for p in verts:
+        f = -0.04 * math.exp(-((p.z - zhi + 0.06) / 0.07) ** 2) * smooth(0.04, 0.12, abs(p.x))  # hip
+        if kind == "jeans":
+            f += 0.05 * math.exp(-((p.z - 0.70) / 0.09) ** 2) * (1.0 if p.y < 0.0 else 0.4)  # thighs fade
+            f -= 0.05 * leg_seam(H, p)  # darker side seams
+        elif kind in ("chinos", "cargo"):
+            f += 0.01 * grain(p)  # twill grain
+        g.append(1.0 + f)
+    return rescale(cols, g)
+
+
